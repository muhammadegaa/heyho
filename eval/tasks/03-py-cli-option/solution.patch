+DURATION = re.compile(r"(\d+)([smhd])")
+
+DURATION_UNITS = {"s": "seconds", "m": "minutes", "h": "hours", "d": "days"}
+
+
+def since_value(text):
+    """Parse --since: an absolute timestamp, or a duration back from the newest entry."""
+    match = DURATION.fullmatch(text)
+    if match:
+        return timedelta(**{DURATION_UNITS[match[2]]: int(match[1])})
+    try:
+        return parse_timestamp(text)
+    except ValueError:
+        raise argparse.ArgumentTypeError(
+            f"expected a UTC timestamp like 2024-03-10T09:00:00Z or a duration like 2h, got {text!r}"
+        ) from None
+
