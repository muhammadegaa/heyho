diff --git a/src/slug.ts b/src/slug.ts
new file mode 100644
index 0000000..ebf5e51
--- /dev/null
+++ b/src/slug.ts
@@ -0,0 +1,19 @@
+/**
+ * Lowercase ASCII words joined by "-", at most `maxLength` characters.
+ * Accents are dropped, "&" becomes "and" and apostrophes disappear.
+ * Returns "" when nothing usable is left; callers pick their own fallback.
+ */
+export function slugify(text: string, maxLength: number): string {
+  let slug = text
+    .normalize("NFKD")
+    .replace(/[\u0300-\u036f]/g, "")
+    .toLowerCase()
+    .replace(/&/g, " and ")
+    .replace(/['’]/g, "")
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "");
+  if (slug.length > maxLength) {
+    slug = slug.slice(0, maxLength).replace(/-+$/, "");
+  }
+  return slug;
+}
